{
  "name": "intelliflow-employee-portal",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "mongodb": "^6.10.0",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.0.1",
    "prettier": "^3.6.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
